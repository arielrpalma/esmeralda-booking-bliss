{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "esmeralda-apart",
      "version": "0.1.0",
      "title": "Esmeralda Apart"
    },
    "tools": [
      {
        "name": "check_availability",
        "title": "Consultar disponibilidad",
        "description": "Check Esmeralda Apart availability for a date range and get a direct booking link plus alternative dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "checkin": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-in date, YYYY-MM-DD."
            },
            "checkout": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-out date, YYYY-MM-DD."
            },
            "adults": {
              "default": 2,
              "description": "Adults (+4 years).",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "children": {
              "default": 0,
              "description": "Children occupying a bed.",
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "babies": {
              "default": 0,
              "description": "Babies under 1 year (no bed).",
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "checkin",
            "checkout"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_property_info",
        "title": "Información del alojamiento",
        "description": "Get verified information about Esmeralda Apart: location, amenities, capacity, check-in and contact.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_booking_link",
        "title": "Enlace de reserva",
        "description": "Build the direct booking-engine link for given dates and guests (does not check availability).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "checkin": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-in date, YYYY-MM-DD."
            },
            "checkout": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-out date, YYYY-MM-DD."
            },
            "adults": {
              "default": 2,
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "children": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "babies": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "checkin",
            "checkout"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
